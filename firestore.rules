rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- 1. GLOBAL PRIMITIVES ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // --- 2. TIERED IDENTITY LOGIC (RBAC) ---
    // Roles: user, parent, health_worker, ngo_admin, gov_admin, super_admin
    function getUserData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function getRole() { return getUserData().role; }
    
    function isSuperAdmin() { return isSignedIn() && getRole() == 'super_admin'; }
    function isGovAdmin() { return isSignedIn() && (getRole() == 'gov_admin' || isSuperAdmin()); }
    function isNGOAdmin() { return isSignedIn() && (getRole() == 'ngo_admin' || isGovAdmin()); }
    function isHealthWorker() { return isSignedIn() && (getRole() == 'health_worker' || isNGOAdmin()); }
    
    // --- 3. FAMILY LOGIC ---
    function isFamilyMember(ownerUid) {
      let ownerFamily = get(/databases/$(database)/documents/users/$(ownerUid)).data.familyId;
      let myFamily = getUserData().familyId;
      return isSignedIn() && ownerFamily != null && ownerFamily == myFamily;
    }

    // --- 4. VALIDATION BLUEPRINTS ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'language', 'onboarded', 'role']) &&
             data.uid == request.auth.uid &&
             data.role in ['user', 'parent', 'health_worker'] && // Only self-register as user, parent, or health_worker
             data.language is string &&
             data.onboarded is bool;
    }

    function isValidHabit(data) {
      return data.keys().hasAll(['userId', 'type', 'value', 'timestamp']) &&
             data.userId == request.auth.uid &&
             data.type in ['water', 'meal', 'exercise', 'junk'] &&
             data.value is number &&
             data.timestamp == request.time;
    }

    function isValidFamily(data) {
      return data.keys().hasAll(['adminId', 'members']) &&
             data.adminId == request.auth.uid &&
             data.members is list &&
             data.members.size() <= 20; // Bound lists
    }

    function isValidDevice(data) {
      return data.keys().hasAll(['userId', 'deviceName', 'deviceType', 'status']) &&
             data.userId == request.auth.uid &&
             data.deviceName is string && data.deviceName.size() <= 200 &&
             data.deviceType in ['Watch', 'Scale', 'BP Monitor', 'Glucose Meter'] &&
             data.status in ['connected', 'disconnected', 'syncing'] &&
             (!data.keys().hasAny(['batteryLevel']) || (data.batteryLevel is number && data.batteryLevel >= 0 && data.batteryLevel <= 100));
    }

    // --- 5. THE MASTER GATE (DENY BY DEFAULT) ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- 6. COLLECTION HARDENING ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isFamilyMember(userId) || isHealthWorker();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'language', 'familyId', 'onboarded', 'ageGroup']) &&
        incoming().role == existing().role // Immutable role via client
      ) || isSuperAdmin();

      match /habits/{habitId} {
        allow list, get: if isOwner(userId) || isFamilyMember(userId);
        allow create: if isOwner(userId) && isValidHabit(incoming()) && isValidId(habitId);
        allow delete: if isOwner(userId);
      }

      match /growth/{recordId} {
        allow list, get: if isOwner(userId) || isFamilyMember(userId) || isHealthWorker();
        allow create: if (isOwner(userId) || isFamilyMember(userId)) && isValidId(recordId);
      }

      match /devices/{deviceId} {
        allow list, get: if isOwner(userId) || isFamilyMember(userId);
        allow create: if isOwner(userId) && isValidDevice(incoming()) && isValidId(deviceId);
        allow delete: if isOwner(userId);
      }

      match /ai_insights/{insightId} {
        allow list, get: if isOwner(userId);
        allow write: if false; // System-only updates via backend
      }
    }

    match /families/{familyId} {
      allow get: if isSignedIn() && (existing().members.hasAny([request.auth.uid]) || isHealthWorker());
      allow create: if isSignedIn() && isValidFamily(incoming());
      allow update: if isSignedIn() && existing().adminId == request.auth.uid;
    }

    match /community_analytics/{reportId} {
      allow list, get: if isNGOAdmin();
      allow write: if false; // System-only
    }

    match /surveys/{surveyId} {
      allow read: if isSignedIn();
      match /responses/{responseId} {
        allow create: if isSignedIn() && incoming().userId == request.auth.uid;
        allow list, get: if isNGOAdmin();
      }
    }

    // --- 7. ADMIN BYPASS ---
    match /admins/{adminId} {
      allow read: if isSuperAdmin();
    }
  }
}
