# ── SERVER SIDE (never exposed to browser) ──────────────────────────────────
GEMINI_API_KEY=                    # From Google AI Studio (aistudio.google.com)
FIREBASE_PROJECT_ID=               # Your Firebase project ID
FIREBASE_CLIENT_EMAIL=             # From Firebase service account JSON
FIREBASE_PRIVATE_KEY=              # From Firebase service account JSON (keep \n escapes)
FIREBASE_DATABASE_ID=              # Firestore database ID (or "(default)")

# ── CLIENT SIDE (safe to expose — Firebase web config, not admin creds) ─────
# Note: Do NOT add VITE_GEMINI_API_KEY — all AI calls go through the backend.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_ID=

# ── DEPLOYMENT ────────────────────────────────────────────────────────────────
APP_URL=                           # Injected by Cloud Run / Vercel at build time
NODE_ENV=production
