{
  "entities": {
    "User": {
      "title": "User Profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "parent", "health_worker", "ngo_admin", "admin"] },
        "ageGroup": { "type": "string", "enum": ["child", "teen", "adult", "elderly", "pregnant"] },
        "language": { "type": "string", "enum": ["en", "te", "hi", "ta", "kn"] },
        "region": { "type": "string" },
        "familyId": { "type": "string" },
        "points": { "type": "integer" },
        "nutriScore": { "type": "integer" },
        "onboarded": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "language", "onboarded", "role"]
    },
    "HabitLog": {
      "title": "Health Habit Log",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["water", "meal", "exercise", "junk"] },
        "value": { "type": "number" },
        "description": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "value", "timestamp"]
    },
    "GrowthRecord": {
      "title": "Pediatric/Elderly Growth Tracking",
      "type": "object",
      "properties": {
        "height": { "type": "number" },
        "weight": { "type": "number" },
        "muac": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["timestamp"]
    },
    "Device": {
      "title": "Connected Health Device",
      "type": "object",
      "properties": {
        "deviceName": { "type": "string" },
        "deviceType": { "type": "string", "enum": ["Watch", "Scale", "BP Monitor", "Glucose Meter"] },
        "status": { "type": "string", "enum": ["connected", "disconnected", "syncing"] },
        "batteryLevel": { "type": "number" },
        "lastSync": { "type": "string", "format": "date-time" }
      },
      "required": ["deviceName", "deviceType", "status"]
    },
    "AIRecommendation": {
      "title": "AI Clinical Insight",
      "type": "object",
      "properties": {
        "category": { "type": "string", "enum": ["nutrition", "activity", "medical_alert", "tip"] },
        "content": { "type": "string" },
        "isRead": { "type": "boolean" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["category", "content", "isRead", "timestamp"]
    },
    "NutritionLog": {
      "title": "Nutrition Log",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "foods": { "type": "array", "items": { "type": "string" } },
        "calories": { "type": "number" },
        "nutrients": { "type": "object" },
        "mealType": { "type": "string", "enum": ["breakfast", "lunch", "dinner", "snack"] },
        "loggedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "date", "foods", "calories", "mealType", "loggedBy", "createdAt"]
    },
    "Post": {
      "title": "Community Post",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorRole": { "type": "string" },
        "likesCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["text", "authorId", "authorName", "authorRole", "likesCount", "createdAt"]
    },
    "Like": {
      "title": "Like relationship",
      "type": "object",
      "properties": {
        "likedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["likedAt"]
    },
    "Comment": {
      "title": "Post Comment",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "authorName": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "authorName", "text", "createdAt"]
    },
    "Family": {
      "title": "Family Circle",
      "type": "object",
      "properties": {
        "adminId": { "type": "string" },
        "members": { "type": "array", "items": { "type": "string" } },
        "name": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["adminId", "members", "name", "createdAt"]
    },
    "Program": {
      "title": "NGO Program",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "targetRegion": { "type": "string" },
        "goals": { "type": "array", "items": { "type": "string" } },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "description", "targetRegion", "goals", "createdBy", "createdAt"]
    },
    "RateLimit": {
      "title": "Rate Limit Information",
      "type": "object",
      "properties": {
        "count": { "type": "integer" },
        "resetTime": { "type": "integer" }
      },
      "required": ["count", "resetTime"]
    },
    "RegionalStats": {
      "title": "Aggregated Regional Analytics",
      "type": "object",
      "properties": {
        "avgCalories": { "type": "number" },
        "avgProtein": { "type": "number" },
        "avgIron": { "type": "number" },
        "userCount": { "type": "integer" },
        "logCount": { "type": "integer" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["avgCalories", "avgProtein", "avgIron", "userCount", "logCount", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles with strict access rules."
    },
    "/users/{userId}/habits/{habitId}": {
      "schema": "HabitLog",
      "description": "Daily habit tracking logs."
    },
    "/users/{userId}/growth/{recordId}": {
      "schema": "GrowthRecord",
      "description": "Height, weight, and development details for kids and elderly."
    },
    "/users/{userId}/devices/{deviceId}": {
      "schema": "Device",
      "description": "Connected smart devices."
    },
    "/users/{userId}/ai_insights/{insightId}": {
      "schema": "AIRecommendation",
      "description": "Nutritional recommendations generated by Gemini."
    },
    "/nutrition_logs/{logId}": {
      "schema": "NutritionLog",
      "description": "Detailed foods logged for meal and nutrition metrics."
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Community bulletin board posts."
    },
    "/posts/{postId}/likes/{userId}": {
      "schema": "Like",
      "description": "Sub-document for tracking atomic likes."
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": "Comment",
      "description": "Comments left on community posts."
    },
    "/families/{familyId}": {
      "schema": "Family",
      "description": "Parent-defined family groups."
    },
    "/programs/{programId}": {
      "schema": "Program",
      "description": "NGO-created community health programs."
    },
    "/rate_limits/{userId}": {
      "schema": "RateLimit",
      "description": "Firestore-backed chat rate limiting."
    },
    "/regional_stats/{region}": {
      "schema": "RegionalStats",
      "description": "Pre-aggregated statistics for regional reporting."
    }
  }
}
